{
    "jobs": [
        {
            "name": "Pipeline - Ingestion Bronze",
            "description": "Extraction des données depuis l'API Hub'Eau vers la couche Bronze",
            "tasks": [
                {
                    "task_key": "ingestion_bronze",
                    "notebook_task": {
                        "notebook_path": "/Repos/khalid-eau-pipeline/notebooks/01_ingestion_bronze"
                    },
                    "new_cluster": {
                        "spark_version": "13.3.x-scala2.12",
                        "node_type_id": "i3.xlarge",
                        "num_workers": 2
                    },
                    "timeout_seconds": 3600
                }
            ]
        },
        {
            "name": "Pipeline - Nettoyage Silver",
            "description": "Nettoyage et transformation des données vers la couche Silver",
            "tasks": [
                {
                    "task_key": "nettoyage_silver",
                    "notebook_task": {
                        "notebook_path": "/Repos/khalid-eau-pipeline/notebooks/02_nettoyage_silver"
                    },
                    "new_cluster": {
                        "spark_version": "13.3.x-scala2.12",
                        "node_type_id": "i3.xlarge",
                        "num_workers": 2
                    },
                    "timeout_seconds": 3600
                }
            ]
        },
        {
            "name": "Pipeline - Analyse Gold",
            "description": "Génération des KPIs et tables analytiques dans la couche Gold",
            "tasks": [
                {
                    "task_key": "analyse_gold",
                    "notebook_task": {
                        "notebook_path": "/Repos/khalid-eau-pipeline/notebooks/03_analyse_gold"
                    },
                    "new_cluster": {
                        "spark_version": "13.3.x-scala2.12",
                        "node_type_id": "i3.xlarge",
                        "num_workers": 2
                    },
                    "timeout_seconds": 3600
                }
            ]
        },
        {
            "name": "Pipeline Complete - Bronze to Gold",
            "description": "Orchestration complète : Ingestion -> Nettoyage -> Analyse",
            "tasks": [
                {
                    "task_key": "bronze",
                    "notebook_task": {
                        "notebook_path": "/Repos/khalid-eau-pipeline/notebooks/01_ingestion_bronze"
                    },
                    "new_cluster": {
                        "spark_version": "13.3.x-scala2.12",
                        "node_type_id": "i3.xlarge",
                        "num_workers": 2
                    },
                    "timeout_seconds": 3600
                },
                {
                    "task_key": "silver",
                    "depends_on": [
                        {
                            "task_key": "bronze"
                        }
                    ],
                    "notebook_task": {
                        "notebook_path": "/Repos/khalid-eau-pipeline/notebooks/02_nettoyage_silver"
                    },
                    "new_cluster": {
                        "spark_version": "13.3.x-scala2.12",
                        "node_type_id": "i3.xlarge",
                        "num_workers": 2
                    },
                    "timeout_seconds": 3600
                },
                {
                    "task_key": "gold",
                    "depends_on": [
                        {
                            "task_key": "silver"
                        }
                    ],
                    "notebook_task": {
                        "notebook_path": "/Repos/khalid-eau-pipeline/notebooks/03_analyse_gold"
                    },
                    "new_cluster": {
                        "spark_version": "13.3.x-scala2.12",
                        "node_type_id": "i3.xlarge",
                        "num_workers": 2
                    },
                    "timeout_seconds": 3600
                }
            ]
        }
    ]
}